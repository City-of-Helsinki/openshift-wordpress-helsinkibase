#!/bin/bash
echo -e "\n===== BEFORE S2I ASSEMBLE =====\n"

echo "# Setup default php config"
mv /tmp/src/config/wp-helfi.ini /etc/php.d/wp-helfi.ini

echo "# Backup composer.json"
cp /tmp/src/composer.json /tmp/composer.json.bak

echo -e "\n===== INSTALL WORDPRESS CORE =====\n"

echo "# Backup custom WordPress files"
mv /tmp/src/.htaccess /tmp/.htaccess.bak
mv /tmp/src/wp-cli.yml /tmp/wp-cli.yml.bak
mv /tmp/src/wp-config.php /tmp/wp-config.php.bak

echo -e "\n# Download WordPress core"
wp core download \
    --version="${WORDPRESS_VERSION}" \
    --path=/tmp/src \
    --skip-content \
    --force \
    --allow-root

WP_CORE_DOWNLOADED=$?
if [ ${WP_CORE_DOWNLOADED} -ne 0 ]; then
    echo -e "\n# Failed to download WordPress core"

    exit ${WP_CORE_DOWNLOADED}
fi

echo -e "\n# Verify WordPress core checksums"
wp core verify-checksums \
    --version="${WORDPRESS_VERSION}" \
    --path=/tmp/src \
    --allow-root

WP_CORE_CHECKSUM_VERIFIED=$?
if [ ${WP_CORE_CHECKSUM_VERIFIED} -ne 0 ]; then
    echo -e "\n# Failed to verify WordPress core checksums"

    exit ${WP_CORE_CHECKSUM_VERIFIED}
fi

echo -e "\n# Restore custom WordPress files"
mv /tmp/.htaccess.bak /tmp/src/.htaccess
mv /tmp/wp-cli.yml.bak /tmp/src/wp-cli.yml
mv /tmp/wp-config.php.bak /tmp/src/wp-config.php

echo -e "\n# Download WordPress core languages"
mkdir -p /tmp/src/wp-content/languages

for locale in fi sv_SE; do
    if curl -fsSL \
        "https://downloads.wordpress.org/translation/core/${WORDPRESS_VERSION}/${locale}.zip" \
        -o "/tmp/${locale}.zip"
    then
        unzip -q "/tmp/${locale}.zip" -d /tmp/src/wp-content/languages
        rm -f "/tmp/${locale}.zip"
    else
        echo "Warning: failed to download WordPress language pack: ${locale}"
        rm -f "/tmp/${locale}.zip"
    fi
done

echo -e "\n===== S2I ASSEMBLE =====\n"
/usr/libexec/s2i/assemble
S2I_ASSEMBLE_SUCCESS=$?

if [ ${S2I_ASSEMBLE_SUCCESS} -eq 0 ]; then
    echo -e "\n===== S2I ASSEMBLE SUCCESSFUL =====\n"

    echo "# Restore composer.json"
    mv /tmp/composer.json.bak "${APP_DATA}/composer.json"

    echo "# Setup composer bin"
    mv "${APP_DATA}/composer.phar" /usr/bin/composer
    chmod +x /usr/bin/composer
    chmod +w "${APP_DATA}/composer.json"

    if [[ ${COMPOSER_REPOSITORIES} ]]; then
        echo "# Setup additional Composer repositories"

        readarray -td "|" REPOSITORIES_LIST <<< "${COMPOSER_REPOSITORIES}"; declare -a REPOSITORIES_LIST;

        for REPO_NAME_TYPE_URL in "${REPOSITORIES_LIST[@]}"
        do
            echo "adding repository with following details: ${REPO_NAME_TYPE_URL}"
            composer config repositories.$(echo "${REPO_NAME_TYPE_URL}" | xargs)
            REPOSITORY_ADDED=$?

            if [ ${REPOSITORY_ADDED} -ne 0 ]; then
                echo "# Failed to add repository to Composer config:"
                echo "${REPO_NAME_TYPE_URL}"

                exit ${REPOSITORY_ADDED}
            fi
        done
    else
        echo "# No additional Composer repositories to add"
    fi

    if [[ ${COMPOSER_PACKAGES} ]]; then
        echo "# Install additional Composer packages"

        composer require ${COMPOSER_PACKAGES}
        PACKAGES_INSTALLED=$?

        if [ ${PACKAGES_INSTALLED} -ne 0 ]; then
            echo "# Failed to require Composer packages:"
            echo ${COMPOSER_PACKAGES} | tr ' ' '\n'

            exit ${PACKAGES_INSTALLED}
        fi
    else
        echo "# No additional Composer packages to install"
    fi

    echo -e "\n===== FILE AND DIRECTORY PERMISSIONS =====\n"

    echo "# Set group ownership to root"
    chgrp -R root ${APP_DATA}

    echo "# Remove group write from EVERYTHING"
    find ${APP_DATA} -type f -exec chmod g-w,o-rwx {} +
    find ${APP_DATA} -type d -exec chmod g-w,o-rwx {} +

    echo "# Selectively add group write"
    chmod g+rw "${APP_DATA}/httpd-cfg/redirects.conf"
    chmod g+rw "${APP_DATA}/.msmtprc"
    chmod -R g+rw "${APP_DATA}/httpd-cfg"

    echo "# Ensure group execute on all directories"
    find ${APP_DATA} -type d -exec chmod g+X {} +

    echo "# Mark custom scripts executable"
    chmod +x "${APP_DATA}/.s2i/bin/run-wrapped"
    chmod +x "${APP_DATA}/utils/generate_redirects.sh"

else
    echo -e "\n===== S2I ASSEMBLE FAILED =====\n"
fi

echo -e "\n===== S2I ASSEMBLE READY =====\n"

# cleanup
rm -rf /mnt/secrets/*
rm -f "${APP_DATA}/.config/composer/auth.*"

exit ${S2I_ASSEMBLE_SUCCESS}
